# strixd — release-binary image (multi-arch, no per-arch Go binary build).
#
# Unlike docker/Dockerfile (which compiles strixd from source with CGO against a
# statically-linked libyara), this variant downloads per-arch binaries straight
# from the selected GitHub release tag, skipping the per-arch Go binary build.
# The unqualified yara stage still runs bootstrap/configure/make for each target
# platform to build a matching `yarac`; the rules stage then compiles an
# architecture-specific .yac. Multi-arch buildx may emulate those stages.
#
# Used by the dockerized daily bake (target debian-mailstrix). The source-compile
# Dockerfile stays the source of truth for CI (release.yml builds the binaries
# this file then consumes).
#
# By default (RELEASE_SOURCE=download) it requires VERSION or RELEASE_TAG to name
# a published release whose assets include
# strixd-linux-${TARGETARCH} and strix-scan-linux-${TARGETARCH}; strix-milter-linux-
# ${TARGETARCH} is shipped too when the release has it. RELEASE_SOURCE=local builds
# from candidate assets in the `local-artifacts` build context instead (see the
# ARG below).
# Releases with marker support also publish yarac-linux-${TARGETARCH} and
# libyara-linux-${TARGETARCH}.a: the exact compiler and static library linked
# into strixd. The rules stage compiles with them and bakes the marker artifact;
# a rebuilt toolchain cannot match (libyara.a is not byte-reproducible).
# Mutable nightly releases also require RELEASE_CACHEBUST (the nightly build SHA);
# changing that token invalidates the fetch layer when their assets are replaced.

ARG YARA_VERSION=4.5.2
ARG VERSION
ARG RELEASE_TAG
# Where the release binaries and marker toolchain come from:
#   download (default) the published release named by VERSION/RELEASE_TAG,
#                      checksum-verified (stage fetch-download);
#   local              candidate assets from the named build context
#                      `local-artifacts` (docker buildx build --build-context
#                      local-artifacts=DIR), laid out as build-binaries.yml
#                      names them (stage fetch-local). A dry run therefore
#                      builds the candidate, not the last release. An incomplete
#                      set fails the build; it never falls back to downloading.
# Any other value names no stage and fails the build.
ARG RELEASE_SOURCE=download

# ---- fetch release binaries (per target architecture) -----------------------
# This unqualified FROM runs for the target platform. It downloads assets
# selected by TARGETARCH without executing the downloaded binaries.
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS fetch-download
ARG VERSION
ARG RELEASE_TAG
ARG TARGETARCH
RUN test -n "${VERSION}" || test -n "${RELEASE_TAG}" || (echo "VERSION or RELEASE_TAG build-arg is required" >&2; exit 1)
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# Strip a leading v if the caller passed a tag-style version.
# Download release binaries and SHA256SUMS, then verify each fetched asset.
# The source-compile Dockerfile builds from trusted source; this variant pulls
# prebuilt artifacts. SHA256SUMS lists every release asset;
# filter to just the assets fetched and check.
WORKDIR /out
ARG RELEASE_CACHEBUST
# strix-milter is optional: releases before it shipped (<= 1.2.0) lack the
# asset, so it is fetched (and checksum-verified) only when SHA256SUMS lists it.
# The marker toolchain (yarac + libyara.a) is a required pair when either is listed.
# Every fetched asset must have exactly one SHA256SUMS line and pass it.
# bins and tools are space-separated lists: word splitting is intended.
# hadolint ignore=SC2086
RUN VER="${VERSION#v}" \
    && tag="${RELEASE_TAG:-v${VER}}" \
    && if [ "${tag}" = nightly ]; then \
         test -n "${RELEASE_CACHEBUST}" || (echo "RELEASE_CACHEBUST build-arg is required for nightly" >&2; exit 1); \
       fi \
    && base="https://github.com/myguard-labs/mailstrix/releases/download/${tag}" \
    && curl -fsSL "${base}/SHA256SUMS"                      -o SHA256SUMS \
    && curl -fsSL "${base}/strixd-linux-${TARGETARCH}"      -o "strixd-linux-${TARGETARCH}" \
    && curl -fsSL "${base}/strix-scan-linux-${TARGETARCH}" -o "strix-scan-linux-${TARGETARCH}" \
    && bins="strixd strix-scan" \
    && if grep -qE "  strix-milter-linux-${TARGETARCH}\$" SHA256SUMS; then \
         curl -fsSL "${base}/strix-milter-linux-${TARGETARCH}" -o "strix-milter-linux-${TARGETARCH}" \
         && bins="${bins} strix-milter"; \
       fi \
    && tools="" \
    && if grep -qE "  (yarac-linux-${TARGETARCH}|libyara-linux-${TARGETARCH}\.a)\$" SHA256SUMS; then \
         curl -fsSL "${base}/yarac-linux-${TARGETARCH}"     -o "yarac-linux-${TARGETARCH}" \
         && curl -fsSL "${base}/libyara-linux-${TARGETARCH}.a" -o "libyara-linux-${TARGETARCH}.a" \
         && tools="yarac-linux-${TARGETARCH} libyara-linux-${TARGETARCH}.a"; \
       fi \
    && for f in $(for b in ${bins}; do echo "${b}-linux-${TARGETARCH}"; done) ${tools}; do \
         test "$(awk -v f="${f}" '$2 == f' SHA256SUMS | wc -l)" -eq 1 \
           || { echo "SHA256SUMS must list ${f} exactly once" >&2; exit 1; }; \
         awk -v f="${f}" '$2 == f' SHA256SUMS; \
       done > SHA256SUMS.arch \
    && sha256sum -c SHA256SUMS.arch \
    && for b in ${bins}; do mv "${b}-linux-${TARGETARCH}" "${b}"; done \
    && mkdir -p bin marker && mv ${bins} bin/ \
    && if [ -n "${tools}" ]; then \
         mv "yarac-linux-${TARGETARCH}" marker/yarac \
         && mv "libyara-linux-${TARGETARCH}.a" marker/libyara.a; \
       fi \
    && rm -f SHA256SUMS SHA256SUMS.arch \
    && chmod +x bin/*
# Ship the NOTICE alongside the binary (final image parity with docker/Dockerfile).
COPY NOTICE /out/NOTICE

# ---- local candidate assets (RELEASE_SOURCE=local) --------------------------
# Only built when selected; the default download path never resolves the
# `local-artifacts` context. Same /out layout as fetch-download.
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS fetch-local
ARG TARGETARCH
COPY docker/release-local-artifacts.sh /usr/local/bin/release-local-artifacts.sh
# hadolint ignore=DL3022
COPY --from=local-artifacts / /in/
RUN sh /usr/local/bin/release-local-artifacts.sh "${TARGETARCH}" /in /out \
    && rm -rf /in
COPY NOTICE /out/NOTICE

# ---- selected release assets ------------------------------------------------
# Everything below consumes `fetch`, whichever source produced it.
# hadolint ignore=DL3006
FROM fetch-${RELEASE_SOURCE} AS fetch

# ---- libyara (static) — only needed to get a matching `yarac` for the rules
#      stage; the final image carries no libyara (binaries are prelinked). ------
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS yara
ARG YARA_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential automake libtool make pkg-config \
        libssl-dev curl ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL "https://github.com/VirusTotal/yara/archive/refs/tags/v${YARA_VERSION}.tar.gz" \
        -o /tmp/yara.tar.gz \
    && echo "1f87056fcb10ee361936ee7b0548444f7974612ebb0e681734d8de7df055d1ec  /tmp/yara.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/yara.tar.gz -C /tmp \
    && rm /tmp/yara.tar.gz
# The fixed random seed and build-dir prefix map keep libyara.a byte-reproducible,
# so one published marker artifact binds across rebuilds of a release.
WORKDIR /tmp/yara-${YARA_VERSION}
RUN ./bootstrap.sh \
    && CFLAGS="-O2 -flto -DNDEBUG -frandom-seed=mailstrix-yara -ffile-prefix-map=/tmp/yara-${YARA_VERSION}=." \
       LDFLAGS="-flto -frandom-seed=mailstrix-yara" \
       ./configure --disable-shared --enable-static --with-crypto \
    && make -j"$(nproc)" && make install && ldconfig
# compile-rules.sh retains compiler inputs through capture-compiler-inputs.py, which
# needs the instrumented yarac. Same patch as docker/Dockerfile (runtime logging
# stays off unless the helper sets MAILSTRIX_COMPILER_INPUT_LOG).
COPY docker/compiler-input-capture.h docker/patch-compiler-input-capture.py /tmp/capture/
RUN python3 /tmp/capture/patch-compiler-input-capture.py . \
    && make -j"$(nproc)" && make install && ldconfig

# ---- rules ------------------------------------------------------------------
# Identical to docker/Dockerfile: compile the seed .yac with the exact libyara's
# yarac (a .yac is version- AND arch-locked to its compiler). This is the one
# stage that compiles YARA rules for the target architecture under a multi-arch bake.
FROM yara AS rules
# curl and ca-certificates are inherited from the yara stage.
RUN apt-get update && apt-get install -y --no-install-recommends \
        unzip python3 \
    && rm -rf /var/lib/apt/lists/*
# filter-rules.py beside fetch-rules.sh (resolved via $(dirname "$0")) for the
# `mail` profile per-rule mail-relevance/license filter; capture-compiler-inputs.py
# beside compile-rules.sh (same $(dirname "$0") lookup).
COPY docker/fetch-rules.sh docker/compile-rules.sh docker/capture-compiler-inputs.py docker/filter-rules.py /usr/local/bin/
COPY docker/build-marker-artifact.py docker/release-marker-toolchain.sh /usr/local/bin/
COPY docker/local-rules/ /usr/local/share/mailstrix-local-rules/
RUN chmod +x /usr/local/bin/fetch-rules.sh /usr/local/bin/compile-rules.sh /usr/local/bin/filter-rules.py
# Install the release's exact marker toolchain before any rule is compiled, so
# the compiled bundles and the marker artifact come from the linked compiler.
COPY --from=fetch /out/bin/strixd /tmp/release/strixd
COPY --from=fetch /out/marker/ /tmp/release/marker/
RUN mode="$(sh /usr/local/bin/release-marker-toolchain.sh /tmp/release/strixd /tmp/release/marker \
        /usr/local/bin/yarac "$(pkg-config --variable=libdir yara)/libyara.a")" \
    && echo "${mode}" > /tmp/release/mode \
    && rm -rf /tmp/release/strixd /tmp/release/marker
ARG CACHEBUST=unset
ARG LOCAL_ONLY=0
# PERF-25 rule profile: mail (default, conservative prune) | full (every rule).
ARG MAILSTRIX_PROFILE=mail
ARG YARAFORGE_SET=full
# Legacy alias: YARAFORGE_FILTER=0 forces the `full` profile (back-compat).
ARG YARAFORGE_FILTER=1
ARG YARAFORGE_URL=
ARG SIGBASE_REF=master
ARG ANYRUN_REF=main
ARG ANYRUN=1
ARG DIDIER_REF=master
ARG DIDIER=1
ARG BARTBLAZE_REF=master
ARG BARTBLAZE=1
ARG INQUEST_REF=main
ARG INQUEST=1
ARG CAPE=1
ARG CAPE_REF=master
ARG YARAIFY=1
ARG YARAIFY_URL=
RUN LOCAL_ONLY="${LOCAL_ONLY}" MAILSTRIX_PROFILE="${MAILSTRIX_PROFILE}" \
        YARAFORGE_SET="${YARAFORGE_SET}" YARAFORGE_FILTER="${YARAFORGE_FILTER}" YARAFORGE_URL="${YARAFORGE_URL}" SIGBASE_REF="${SIGBASE_REF}" \
        ANYRUN="${ANYRUN}" ANYRUN_REF="${ANYRUN_REF}" \
        DIDIER="${DIDIER}" DIDIER_REF="${DIDIER_REF}" \
        BARTBLAZE="${BARTBLAZE}" BARTBLAZE_REF="${BARTBLAZE_REF}" \
        INQUEST="${INQUEST}" INQUEST_REF="${INQUEST_REF}" \
        CAPE="${CAPE}" CAPE_REF="${CAPE_REF}" \
        YARAIFY="${YARAIFY}" YARAIFY_URL="${YARAIFY_URL}" \
        /usr/local/bin/fetch-rules.sh /rules/src \
    && cp /usr/local/share/mailstrix-local-rules/*.yara /rules/src/ \
    && /usr/local/bin/compile-rules.sh /rules/src /rules/compiled.yac \
    && mkdir -p /rules/local-src \
    && cp /usr/local/share/mailstrix-local-rules/*.yara /rules/local-src/ \
    && /usr/local/bin/compile-rules.sh /rules/local-src /rules/local.yac \
    && if [ "$(cat /tmp/release/mode)" = marker ]; then \
         python3 /usr/local/bin/build-marker-artifact.py /rules; \
       fi \
    && rm -rf /rules/src /rules/local-src \
    && install -d -o 65532 -g 65532 /var/cache/mailstrix \
    && yarac --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 > /rules/libyara.version

# Same verified export as docker/Dockerfile; export-marker additionally requires
# and verifies the bound marker artifact for marker-capable releases.
FROM rules AS rules-export-inputs
COPY docker/export-compiler-inputs.py /usr/local/bin/
RUN if [ "$(cat /tmp/release/mode)" = marker ]; then cmd="export-marker"; else cmd="export"; fi \
    && python3 /usr/local/bin/export-compiler-inputs.py "${cmd}" /rules /rules-export

# ---- rules export (for docker/generate-rules.sh; not a runtime image) ------
# `docker buildx build -f docker/Dockerfile.release --build-arg RELEASE_TAG=<tag>
# --target rules-export --output type=local,dest=out .` drops the bundle compiled
# with the release's exact marker toolchain plus its marker tree, so the
# publisher can sign a marker field that binds to that release's binary.
FROM scratch AS rules-export
COPY --from=rules-export-inputs /rules-export/ /

# ---- rules verifier (for docker/generate-rules.sh; not a runtime image) -----
# The released strixd itself: the binary whose linked libyara/compiler identity
# a published marker tree must bind to, used for `fetch-rules -verify-only
# -require-marker`. No baked rules and no production cache.
FROM gcr.io/distroless/base-debian12:nonroot@sha256:7f0c72cd138b442ae0deeb69c08b1acf5525439ba251a49ad93c320a061567e5 AS rules-verifier
COPY --from=fetch /out/bin/strixd /usr/local/bin/strixd
ENTRYPOINT ["/usr/local/bin/strixd", "fetch-rules", "-verify-only"]

# ---- final (distroless, nonroot) -------------------------------------------
FROM gcr.io/distroless/base-debian12:nonroot@sha256:7f0c72cd138b442ae0deeb69c08b1acf5525439ba251a49ad93c320a061567e5 AS final
ARG VERSION
ARG RELEASE_TAG
# The label follows RELEASE_TAG or VERSION verbatim. Set BUILD_VERSION explicitly
# when a caller needs a normalized label (for example, a leading v).
ARG BUILD_VERSION=${RELEASE_TAG:-${VERSION}}
LABEL org.opencontainers.image.version="${BUILD_VERSION}"
# Same three binaries as docker/Dockerfile's final image (strix-milter only
# when the release carries it), so :latest and :testing behave alike.
COPY --from=fetch /out/bin/ /usr/local/bin/
# compiled.yac, local.yac, sources.json, their retained compiler inputs and,
# for marker-capable releases, the bound native marker artifact.
COPY --from=rules-export-inputs /rules-export/ /usr/share/mailstrix/
COPY --from=fetch /out/NOTICE /usr/share/mailstrix/NOTICE
COPY --from=rules --chown=nonroot:nonroot /var/cache/mailstrix /var/cache/mailstrix
ENV MAILSTRIX_SEED_RULES=/usr/share/mailstrix/compiled.yac \
    MAILSTRIX_BIGFILE_RULES=/usr/share/mailstrix/local.yac \
    MAILSTRIX_CACHE_DIR=/var/cache/mailstrix \
    MAILSTRIX_RULES_POLL_INTERVAL=86400 \
    MAILSTRIX_HOST=0.0.0.0 \
    MAILSTRIX_PORT=8079
EXPOSE 8079
USER nonroot
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["/usr/local/bin/strixd", "health"]
ENTRYPOINT ["/usr/local/bin/strixd"]
CMD ["serve"]
